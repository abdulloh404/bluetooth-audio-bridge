        </mxCell>
        <mxCell id="binaries"
          value="&lt;b&gt;$HOME/.local/bin/ · executable 0755&lt;/b&gt;&lt;br&gt;bluetooth-audio-bridge&lt;br&gt;bluetooth-audio-bridged&lt;br&gt;bluetooth-audio-bridge-phone-policy"
          style="whiteSpace=wrap;html=1;strokeWidth=2;fontFamily=Noto Sans, Noto Sans Thai, Arial, sans-serif;fontColor=#172B45;align=center;verticalAlign=middle;spacing=12;rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#7B8CA3;fontSize=16;"
          vertex="1" parent="1">
          <mxGeometry x="90" y="860" width="650" height="150" as="geometry" />
        </mxCell>
        <mxCell id="unit"
          value="&lt;b&gt;$XDG_CONFIG_HOME/systemd/user/&lt;/b&gt;&lt;br&gt;bluetooth-audio-bridge.service · 0644&lt;br&gt;ExecStart ใช้ daemon ที่ ~/.local/bin"
          style="whiteSpace=wrap;html=1;strokeWidth=2;fontFamily=Noto Sans, Noto Sans Thai, Arial, sans-serif;fontColor=#172B45;align=center;verticalAlign=middle;spacing=12;rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#7B8CA3;fontSize=15;"
          vertex="1" parent="1">
          <mxGeometry x="875" y="870" width="520" height="130" as="geometry" />
        </mxCell>
        <mxCell id="config"
          value="&lt;b&gt;$XDG_CONFIG_HOME/bluetooth-audio-bridge/&lt;/b&gt;&lt;br&gt;config.toml · 0600 เฉพาะเมื่อยังไม่มีไฟล์&lt;br&gt;$XDG_DATA_HOME/bluetooth-audio-bridge/&lt;br&gt;install-marker = BLUETOOTH_AUDIO_BRIDGE_INSTALL=1"
          style="whiteSpace=wrap;html=1;strokeWidth=2;fontFamily=Noto Sans, Noto Sans Thai, Arial, sans-serif;fontColor=#172B45;align=center;verticalAlign=middle;spacing=12;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#FAF3E1;strokeColor=#B19B64;spacingTop=20;fontSize=15;"
          vertex="1" parent="1">
          <mxGeometry x="1530" y="850" width="600" height="165" as="geometry" />
        </mxCell>
        <mxCell id="install-finish"
          value="&lt;b&gt;ติดตั้งเสร็จ → แสดงคำสั่งให้ผู้ใช้เลือกเริ่ม service; installer ไม่เรียก daemon-reload / enable / start / restart&lt;/b&gt;&lt;br&gt;make install ไม่ติดตั้งกฎปิด Bluetooth autoconnect; หากพบไฟล์กฎเดิม จะเตือนและคงไฟล์นั้นไว้"
          style="whiteSpace=wrap;html=1;strokeWidth=2;fontFamily=Noto Sans, Noto Sans Thai, Arial, sans-serif;fontColor=#172B45;align=center;verticalAlign=middle;spacing=12;rounded=1;arcSize=14;fillColor=#EBF6EE;strokeColor=#639275;fontSize=16;"
          vertex="1" parent="1">
          <mxGeometry x="95" y="1040" width="2035" height="75" as="geometry" />
        </mxCell>
        <mxCell id="policy-command"
          value="&lt;b&gt;make phone-policy → preview&lt;/b&gt;&lt;br&gt;make phone-policy-install → --install&lt;br&gt;เรียก scripts/phone-policy.sh"
          style="whiteSpace=wrap;html=1;strokeWidth=2;fontFamily=Noto Sans, Noto Sans Thai, Arial, sans-serif;fontColor=#172B45;align=center;verticalAlign=middle;spacing=12;rounded=1;arcSize=48;fillColor=#243F62;strokeColor=#243F62;fontColor=#FFFFFF;fontSize=15;"
          vertex="1" parent="1">
          <mxGeometry x="90" y="1280" width="375" height="125" as="geometry" />
        </mxCell>
        <mxCell id="versions"
          value="&lt;b&gt;ตรวจ PipeWire ≥ 0.3.48&lt;/b&gt;&lt;br&gt;รองรับ WirePlumber 0.4 / 0.5&lt;br&gt;ถ้า wireplumber --version ใช้ไม่ได้&lt;br&gt;อ่าน dpkg-query จาก package เจ้าของ executable"
          style="whiteSpace=wrap;html=1;strokeWidth=2;fontFamily=Noto Sans, Noto Sans Thai, Arial, sans-serif;fontColor=#172B45;align=center;verticalAlign=middle;spacing=12;rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#7B8CA3;fontSize=15;"
          vertex="1" parent="1">
          <mxGeometry x="565" y="1265" width="405" height="145" as="geometry" />
        </mxCell>
        <mxCell id="policy-format"
          value="&lt;b&gt;เลือกไฟล์ตาม WirePlumber&lt;/b&gt;&lt;br&gt;0.4 → wireplumber/bluetooth.lua.d/&lt;br&gt;90-bluetooth-audio-bridge-phone.lua&lt;br&gt;0.5 → wireplumber/wireplumber.conf.d/&lt;br&gt;90-bluetooth-audio-bridge-phone.conf"
          style="whiteSpace=wrap;html=1;strokeWidth=2;fontFamily=Noto Sans, Noto Sans Thai, Arial, sans-serif;fontColor=#172B45;align=center;verticalAlign=middle;spacing=12;rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#7B8CA3;fontSize=15;"
          vertex="1" parent="1">
          <mxGeometry x="1080" y="1245" width="525" height="185" as="geometry" />
        </mxCell>
        <mxCell id="install-policy" value="&lt;b&gt;มี --install?&lt;/b&gt;"
          style="whiteSpace=wrap;html=1;strokeWidth=2;fontFamily=Noto Sans, Noto Sans Thai, Arial, sans-serif;fontColor=#172B45;align=center;verticalAlign=middle;spacing=12;rhombus;perimeter=rhombusPerimeter;fillColor=#FFF3D9;strokeColor=#B99145;spacing=4;fontSize=16;"
          vertex="1" parent="1">
          <mxGeometry x="1700" y="1275" width="200" height="140" as="geometry" />
        </mxCell>
        <mxCell id="preview"
          value="&lt;b&gt;ไม่ → แสดงกฎ&lt;/b&gt;&lt;br&gt;แล้วจบ&lt;br&gt;ไม่เขียนไฟล์"
          style="whiteSpace=wrap;html=1;strokeWidth=2;fontFamily=Noto Sans, Noto Sans Thai, Arial, sans-serif;fontColor=#172B45;align=center;verticalAlign=middle;spacing=12;rounded=1;arcSize=32;fillColor=#EAF5EF;strokeColor=#689481;fontSize=15;"
          vertex="1" parent="1">
          <mxGeometry x="1990" y="1275" width="180" height="115" as="geometry" />
        </mxCell>
        <mxCell id="write-policy"
          value="&lt;b&gt;ใช่ → ตรวจ owner / symlink / marker เดิม&lt;/b&gt;&lt;br&gt;สร้าง temp 0600 → write + fsync → replace&lt;br&gt;เก็บ policy ใน XDG_CONFIG_HOME&lt;br&gt;เสร็จแล้วให้ผู้ใช้ออกจากระบบและเข้าใหม่"
          style="whiteSpace=wrap;html=1;strokeWidth=2;fontFamily=Noto Sans, Noto Sans Thai, Arial, sans-serif;fontColor=#172B45;align=center;verticalAlign=middle;spacing=12;rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#7B8CA3;fontSize=15;"
          vertex="1" parent="1">
          <mxGeometry x="1640" y="1490" width="530" height="155" as="geometry" />
        </mxCell>
        <mxCell id="rule-scope"
          value="กฎจับเฉพาะ bluez_input.* ที่ api.bluez5.profile=a2dp-source&lt;br&gt;ตั้ง node.autoconnect=false, node.dont-reconnect=true, node.dont-fallback=true&lt;br&gt;ตั้ง bluetooth-audio-bridge.phone=true และ mode=system-output&lt;br&gt;หัวไฟล์ระบุ POLICY=1 / SCOPE=a2dp-source / ROUTE=system-output · version ไม่รองรับหรือไฟล์ไม่ปลอดภัย → error&lt;br&gt;helper ไม่เปลี่ยน output / codec / profile และไม่เริ่มหรือ restart บริการ"
          style="whiteSpace=wrap;html=1;strokeWidth=2;fontFamily=Noto Sans, Noto Sans Thai, Arial, sans-serif;fontColor=#172B45;align=center;verticalAlign=middle;spacing=12;rounded=1;arcSize=8;fillColor=#F6F8FB;strokeColor=#CAD5E2;strokeWidth=1;align=left;spacingLeft=18;spacingRight=16;fontSize=15;"
          vertex="1" parent="1">
          <mxGeometry x="90" y="1480" width="1440" height="170" as="geometry" />
        </mxCell>
        <mxCell id="login"
          value="&lt;b&gt;ถ้าติดตั้ง/เปลี่ยนกฎเสริม&lt;/b&gt;&lt;br&gt;ผู้ใช้ออกจากระบบแล้วเข้าใหม่&lt;br&gt;WirePlumber จึงโหลดกฎนั้น&lt;br&gt;ขั้นนี้ไม่จำเป็นต่อการติดตั้งปกติ"
          style="whiteSpace=wrap;html=1;strokeWidth=2;fontFamily=Noto Sans, Noto Sans Thai, Arial, sans-serif;fontColor=#172B45;align=center;verticalAlign=middle;spacing=12;rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#7B8CA3;fontSize=15;"
          vertex="1" parent="1">
          <mxGeometry x="90" y="1825" width="430" height="135" as="geometry" />
        </mxCell>
        <mxCell id="user-reload"
          value="&lt;b&gt;ผู้ใช้สั่ง&lt;/b&gt;&lt;br&gt;systemctl --user daemon-reload&lt;br&gt;โหลด unit ที่ติดตั้งไว้"
          style="whiteSpace=wrap;html=1;strokeWidth=2;fontFamily=Noto Sans, Noto Sans Thai, Arial, sans-serif;fontColor=#172B45;align=center;verticalAlign=middle;spacing=12;rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#7B8CA3;fontSize=16;"
          vertex="1" parent="1">
          <mxGeometry x="640" y="1825" width="450" height="135" as="geometry" />
        </mxCell>
        <mxCell id="user-start"
          value="&lt;b&gt;ผู้ใช้สั่ง start bluetooth-audio-bridge.service&lt;/b&gt;&lt;br&gt;ผ่าน systemctl --user&lt;br&gt;ถ้าต้องการเริ่มพร้อม login ใช้ enable --now&lt;br&gt;ใช้ stop เพื่อหยุด controller&lt;br&gt;การต่อเสียงขึ้นกับโหมดในหน้า 01"
          style="whiteSpace=wrap;html=1;strokeWidth=2;fontFamily=Noto Sans, Noto Sans Thai, Arial, sans-serif;fontColor=#172B45;align=center;verticalAlign=middle;spacing=12;rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#7B8CA3;fontSize=15;"
          vertex="1" parent="1">
          <mxGeometry x="1210" y="1805" width="520" height="175" as="geometry" />
        </mxCell>
        <mxCell id="user-status"
          value="&lt;b&gt;bluetooth-audio-bridge status&lt;/b&gt;&lt;br&gt;หรือ make status&lt;br&gt;ดูผล controller ตามหน้า 05"
          style="whiteSpace=wrap;html=1;strokeWidth=2;fontFamily=Noto Sans, Noto Sans Thai, Arial, sans-serif;fontColor=#172B45;align=center;verticalAlign=middle;spacing=12;rounded=1;arcSize=32;fillColor=#EAF5EF;strokeColor=#689481;fontSize=15;"
          vertex="1" parent="1">
          <mxGeometry x="1840" y="1840" width="290" height="105" as="geometry" />
        </mxCell>
        <mxCell id="make-map"
          value="Make targets อื่น: help = แสดงวิธีใช้ · config = CLI config show · run = daemon ที่ติดตั้งแล้วแบบ foreground&lt;br&gt; devices / status / enable / disable = ส่งคำสั่งชื่อเดียวกันไป CLI · select [STATE=on|off] = เปิดเมนูหรือส่งค่า&lt;br&gt; volume CHANNEL=phone|desktop|master VALUE=0..1 · mute CHANNEL=phone|desktop|master STATE=on|off&lt;br&gt; uninstall = scripts/uninstall.sh (หน้า 10) · XDG ที่ไม่ตั้งค่าใช้ตำแหน่งมาตรฐานใน home; runtime ใช้ XDG_RUNTIME_DIR ของ desktop session"
          style="whiteSpace=wrap;html=1;strokeWidth=2;fontFamily=Noto Sans, Noto Sans Thai, Arial, sans-serif;fontColor=#172B45;align=center;verticalAlign=middle;spacing=12;rounded=1;arcSize=8;fillColor=#F6F8FB;strokeColor=#CAD5E2;strokeWidth=1;align=left;spacingLeft=18;spacingRight=16;fontSize=15;"
          vertex="1" parent="1">
          <mxGeometry x="95" y="2050" width="2035" height="130" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
