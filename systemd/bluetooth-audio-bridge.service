# BLUETOOTH_AUDIO_BRIDGE_MANAGED_SERVICE=1
[Unit]
Description=Bluetooth Audio Bridge through the Ubuntu audio output
After=pipewire.service wireplumber.service

[Service]
Type=simple
ExecStart=%h/.local/bin/bluetooth-audio-bridged
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
